<h1>Learn Birds</h1>

<div class="learning-item">
    <p>Birds are amazing flying creatures that live all around the world. Let's discover different types of birds!</p>
</div>

<div class="learning-grid">
    <% 
        const birds = [
            { name: 'Eagle', emoji: '🦅', sound: 'screech', habitat: 'Mountains', characteristic: 'Sharp talons for hunting' },
            { name: 'Owl', emoji: '🦉', sound: 'hoot', habitat: 'Forest', characteristic: 'Active at night' },
            { name: 'Parrot', emoji: '🦜', sound: 'squawk', habitat: 'Tropical Forest', characteristic: 'Can mimic sounds' },
            { name: 'Robin', emoji: '🐦', sound: 'chirp', habitat: 'Gardens', characteristic: 'Red breast feathers' },
            { name: 'Penguin', emoji: '🐧', sound: 'trumpet', habitat: 'Antarctic', characteristic: 'Cannot fly but swims well' },
            { name: 'Flamingo', emoji: '🦩', sound: 'honk', habitat: 'Wetlands', characteristic: 'Pink feathers and long legs' },
            { name: 'Peacock', emoji: '🦚', sound: 'scream', habitat: 'Forests', characteristic: 'Beautiful colorful tail feathers' },
            { name: 'Swan', emoji: '🦢', sound: 'trumpet', habitat: 'Lakes', characteristic: 'Graceful neck and white feathers' },
            { name: 'Duck', emoji: '🦆', sound: 'quack', habitat: 'Ponds', characteristic: 'Waterproof feathers' },
            { name: 'Chicken', emoji: '🐔', sound: 'cluck', habitat: 'Farm', characteristic: 'Lays eggs for food' },
            { name: 'Woodpecker', emoji: '🐦', sound: 'tap', habitat: 'Forest', characteristic: 'Pecks holes in trees' },
            { name: 'Hummingbird', emoji: '🐦', sound: 'hum', habitat: 'Gardens', characteristic: 'Tiny and hovers while flying' }
        ];
    %>
    
    <% birds.forEach(bird => { %>
        <div class="interactive-element" data-audio="/audio/birds/<%= bird.name.toLowerCase() %>.mp3">
            <div class="bird-icon"><%= bird.emoji %></div>
            <h3><%= bird.name %></h3>
            <p><%= bird.sound %></p>
        </div>
    <% }) %>
</div>

<div class="learning-item">
    <h2>Bird Habitats</h2>
    <p>Birds live in many different places around the world. Let's learn where different birds make their homes!</p>
    
    <div class="habitat-container">
        <div class="habitat">
            <h3>Forest</h3>
            <div class="habitat-image">
                <img src="https://via.placeholder.com/300x200?text=Forest" alt="Forest">
            </div>
            <div class="habitat-animals">
                <span class="animal-tag">Owl 🦉</span>
                <span class="animal-tag">Woodpecker 🐦</span>
                <span class="animal-tag">Parrot 🦜</span>
                <span class="animal-tag">Peacock 🦚</span>
            </div>
        </div>
        
        <div class="habitat">
            <h3>Water Areas</h3>
            <div class="habitat-image">
                <img src="https://via.placeholder.com/300x200?text=Lake" alt="Lake">
            </div>
            <div class="habitat-animals">
                <span class="animal-tag">Duck 🦆</span>
                <span class="animal-tag">Swan 🦢</span>
                <span class="animal-tag">Flamingo 🦩</span>
                <span class="animal-tag">Penguin 🐧</span>
            </div>
        </div>
        
        <div class="habitat">
            <h3>Mountains</h3>
            <div class="habitat-image">
                <img src="https://via.placeholder.com/300x200?text=Mountains" alt="Mountains">
            </div>
            <div class="habitat-animals">
                <span class="animal-tag">Eagle 🦅</span>
            </div>
        </div>
        
        <div class="habitat">
            <h3>Gardens & Yards</h3>
            <div class="habitat-image">
                <img src="https://via.placeholder.com/300x200?text=Garden" alt="Garden">
            </div>
            <div class="habitat-animals">
                <span class="animal-tag">Robin 🐦</span>
                <span class="animal-tag">Hummingbird 🐦</span>
            </div>
        </div>
    </div>
</div>

<div class="learning-item">
    <h2>Bird Sound Game</h2>
    <p>Can you match the bird to its sound?</p>
    
    <div class="sound-game">
        <div class="game-round">
            <button class="sound-button" data-sound="hoot">Play Sound</button>
            <p>Which bird makes this sound?</p>
            <div class="animal-options">
                <button class="animal-option" data-animal="owl">Owl 🦉</button>
                <button class="animal-option" data-animal="eagle">Eagle 🦅</button>
                <button class="animal-option" data-animal="duck">Duck 🦆</button>
            </div>
            <div class="feedback"></div>
            <button class="btn next-sound" style="display: none;">Next Sound</button>
        </div>
    </div>
</div>

<div class="learning-item">
    <h2>Bird Characteristics Game</h2>
    <p>Learn about what makes each bird special!</p>
    
    <div class="characteristics-game">
        <div class="game-round">
            <div class="bird-card">
                <div class="bird-image">🦩</div>
                <h3>Flamingo</h3>
                <button class="reveal-btn" data-characteristic="Pink feathers and long legs">What's Special?</button>
                <div class="characteristic-reveal" style="display: none;">
                    <p>Pink feathers and long legs</p>
                </div>
            </div>
        </div>
        
        <div class="game-round">
            <div class="bird-card">
                <div class="bird-image">🐧</div>
                <h3>Penguin</h3>
                <button class="reveal-btn" data-characteristic="Cannot fly but swims well">What's Special?</button>
                <div class="characteristic-reveal" style="display: none;">
                    <p>Cannot fly but swims well</p>
                </div>
            </div>
        </div>
        
        <div class="game-round">
            <div class="bird-card">
                <div class="bird-image">🦜</div>
                <h3>Parrot</h3>
                <button class="reveal-btn" data-characteristic="Can mimic sounds">What's Special?</button>
                <div class="characteristic-reveal" style="display: none;">
                    <p>Can mimic sounds</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="quiz-container">
    <h2>Birds Quiz</h2>
    <p>Test your knowledge about birds!</p>
    
    <form class="quiz-form">
        <div class="quiz-question" data-correct="eagle">
            <p>Which bird is known for its sharp talons and hunting skills?</p>
            <div class="options">
                <label><input type="radio" name="q1" value="robin"> Robin</label>
                <label><input type="radio" name="q1" value="eagle"> Eagle</label>
                <label><input type="radio" name="q1" value="duck"> Duck</label>
            </div>
        </div>
        
        <div class="quiz-question" data-correct="night">
            <p>When are owls most active?</p>
            <div class="options">
                <label><input type="radio" name="q2" value="morning"> Morning</label>
                <label><input type="radio" name="q2" value="night"> Night</label>
                <label><input type="radio" name="q2" value="afternoon"> Afternoon</label>
            </div>
        </div>
        
        <div class="quiz-question" data-correct="hoot">
            <p>What sound does an owl make?</p>
            <div class="options">
                <label><input type="radio" name="q3" value="quack"> Quack</label>
                <label><input type="radio" name="q3" value="hoot"> Hoot</label>
                <label><input type="radio" name="q3" value="chirp"> Chirp</label>
            </div>
        </div>
        
        <button type="submit" class="btn">Check Answers</button>
        
        <div class="quiz-result"></div>
    </form>
</div>

<div class="navigation-buttons">
    <a href="/animals" class="btn">← Learn Animals</a>
    <a href="/" class="btn">Back to Home</a>
</div>